<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cool_gray"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:id="@+id/imgTopIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_petrol_app"
            android:contentDescription="@string/app_icon_desc"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtAppTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_subtitle"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_tab_container"
            android:padding="4dp">

            <TextView
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/btn_calculator"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_tab_indicator" />

            <TextView
                android:id="@+id/btnAbout"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/btn_developer_info"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_tab_indicator" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/homeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_content_card"
                android:elevation="4dp"
                android:padding="24dp"
                android:paddingBottom="32dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_petrol_details"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:paddingBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_petrol_details_desc"
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:paddingBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_select_petrol"
                    android:textStyle="bold"
                    android:textColor="@color/brand_slate"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgPetrolType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp">

                    <RadioButton
                        android:id="@+id/rbRon95"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:background="@drawable/bg_ron95_selector"
                        android:textColor="@color/text_petrol_selector"
                        android:textAllCaps="false"
                        android:lineSpacingMultiplier="0.8"
                        android:layout_margin="10dp"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbRon97"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:background="@drawable/bg_ron97_selector"
                        android:textColor="@color/text_petrol_selector"
                        android:textAllCaps="false"
                        android:lineSpacingMultiplier="0.8"
                        android:layout_margin="10dp" />

                    <RadioButton
                        android:id="@+id/rbDiesel"
                        android:layout_width="0dp"
                        android:layout_height="72dp"
                        android:layout_weight="1"
                        android:button="@null"
                        android:gravity="center"
                        android:background="@drawable/bg_diesel_selector"
                        android:textColor="@color/text_petrol_selector"
                        android:textAllCaps="false"
                        android:lineSpacingMultiplier="0.8"
                        android:layout_margin="10dp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Card 2: Price & Usage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_content_card"
                android:elevation="4dp"
                android:padding="24dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_petrol_price"
                    android:textStyle="bold"
                    android:textColor="@color/brand_slate"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/edtPetrolPrice"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@drawable/ic_money"
                    android:drawablePadding="12dp"
                    android:hint="@string/hint_petrol_price"
                    android:inputType="numberDecimal"
                    android:digits="0123456789."
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:layout_marginBottom="16dp"
                    android:autofillHints="none" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_fuel_usage"
                    android:textStyle="bold"
                    android:textColor="@color/brand_slate"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/edtFuelUsage"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input"
                    android:drawableStart="@drawable/ic_liter"
                    android:drawablePadding="12dp"
                    android:hint="@string/hint_fuel_usage"
                    android:inputType="numberDecimal"
                    android:digits="0123456789."
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:layout_marginBottom="8dp"
                    android:autofillHints="none" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnQuick20"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/vol_20l"
                        android:textSize="12sp"
                        android:textColor="@color/brand_blue"
                        android:background="@drawable/bg_button_ghost" />

                    <Button
                        android:id="@+id/btnQuick40"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:text="@string/vol_40l"
                        android:textSize="12sp"
                        android:textColor="@color/brand_blue"
                        android:background="@drawable/bg_button_ghost"
                        android:layout_marginStart="8dp" />

                    <Button
                        android:id="@+id/btnQuickFull"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.2"
                        android:text="@string/vol_full"
                        android:textSize="12sp"
                        android:textColor="@color/brand_blue"
                        android:background="@drawable/bg_button_ghost"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: Eligibility & Calculation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_content_card"
                android:elevation="4dp"
                android:padding="24dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_eligibility"
                    android:textStyle="bold"
                    android:textColor="@color/brand_slate"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rgEligibility"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <RadioButton
                        android:id="@+id/rbEligibleYes"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/yes"
                        android:button="@null"
                        android:gravity="center"
                        android:background="@drawable/bg_segmented_green"
                        android:textColor="@color/text_petrol_selector"
                        android:textStyle="bold"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbEligibleNo"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/no"
                        android:button="@null"
                        android:gravity="center"
                        android:background="@drawable/bg_segmented_slate"
                        android:textColor="@color/text_petrol_selector"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnCalculate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_calculate"
                    android:background="@drawable/bg_button_primary"
                    android:textColor="@color/white"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:shadowColor="#A0000000"
                    android:shadowDx="1.5"
                    android:shadowDy="1.5"
                    android:shadowRadius="1.5" />

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_reset"
                    android:background="@drawable/bg_reset_button"
                    android:textColor="@color/text_reset_selector"
                    android:textAllCaps="false"
                    android:textStyle="normal"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Card 4: Cost Breakdown Summary -->
            <LinearLayout
                android:id="@+id/cardSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_content_card"
                android:elevation="4dp"
                android:padding="24dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                tools:visibility="visible"
                android:alpha="0">

                <TextView
                    android:id="@+id/txtResultTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/result_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:paddingBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_money"
                        android:contentDescription="@null"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/txtTotalCost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/result_total_cost"
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_fuel"
                        android:contentDescription="@null"
                        app:tint="@color/text_secondary" />

                    <TextView
                        android:id="@+id/txtBudiRebate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/result_budi_rebate"
                        android:textSize="15sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E2E8F0"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_check"
                        android:contentDescription="@null"
                        app:tint="@color/brand_blue" />

                    <TextView
                        android:id="@+id/txtTotalSaving"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/result_total_saving"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="@color/text_muted"
                    android:paddingTop="8dp"
                    android:textStyle="italic" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/aboutSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_content_card"
            android:elevation="4dp"
            android:padding="24dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/imgAppIcon"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:src="@drawable/ic_petrol_app"
                android:layout_gravity="center"
                android:contentDescription="@string/app_icon_container_desc"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_about_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_about_desc"
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:gravity="center"
                android:paddingBottom="24dp" />

            <TextView
                android:id="@+id/txtAuthorInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/author_info"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="6dp"
                android:paddingBottom="16dp" />

            <TextView
                android:id="@+id/txtCopyright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/copyright_text"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:paddingBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_repo_host"
                android:textStyle="bold"
                android:textColor="@color/brand_slate"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/txtGithubUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/repo_url"
                android:textSize="14sp"
                android:textColor="@color/brand_blue"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:autofillHints="none" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>